{
  "manifest_version": 3,
  "name": "‘Quick Look’ for LINKS",
  "short_name": "Quick Look",
  "version": "1.2.0",
  "description": "Hover any link and press Space to preview it without leaving your tab. Arrow keys flip through the rest, the way Finder does with files.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "‘Quick Look’ for LINKS",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "contextMenus",
    "activeTab",
    "favicon"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "preview/preview.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
